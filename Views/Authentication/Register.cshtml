@model EventTicketingWebApp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Sign Up - ETicketing System";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<body class="auth-body register-page">
    <!-- Main Content -->
    <main class="auth-main">
        <div class="auth-container">
            <!-- Header Section - Left Side -->
            <div class="register-header-section">
                <div class="auth-logo">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <h1>Create Account</h1>
                <p>Join us and start discovering amazing events</p>
            </div>

            <!-- Form Section - Right Side -->
            <div class="auth-card">
                <form class="auth-form" id="registerForm" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="FirstName">First Name</label>
                            <div class="input-group">
                                <i class="fas fa-user"></i>
                                <input asp-for="FirstName" placeholder="Enter your first name" required>
                            </div>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="LastName">Last Name</label>
                            <div class="input-group">
                                <i class="fas fa-user"></i>
                                <input asp-for="LastName" placeholder="Enter your last name" required>
                            </div>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email Address</label>
                        <div class="input-group">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email" placeholder="Enter your email" required>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PhoneNumber">Phone Number</label>
                        <div class="input-group">
                            <i class="fas fa-phone"></i>
                            <input asp-for="PhoneNumber" placeholder="Enter your phone number" required>
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Role">Account Type</label>
                        <div class="input-group">
                            <i class="fas fa-user-tag"></i>
                            <select asp-for="Role" id="roleSelect" required>
                                <option value="">Select account type</option>
                                <option value="@((int)EventTicketingWebApp.Helpers.UserRole.Customer)">Customer - Buy tickets for events</option>
                                <option value="@((int)EventTicketingWebApp.Helpers.UserRole.Organizer)">Organizer - Buy Ticket + Create your own Events</option>
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <!-- Organization fields (shown only for Organizer role) -->
                    <div id="organizationFields" style="display: none;">
                        <div class="form-group">
                            <label asp-for="OrganizationName">Organization Name</label>
                            <div class="input-group">
                                <i class="fas fa-building"></i>
                                <input asp-for="OrganizationName" placeholder="Enter organization name">
                            </div>
                            <span asp-validation-for="OrganizationName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="OrganizationTelephone">Organization Phone</label>
                            <div class="input-group">
                                <i class="fas fa-phone"></i>
                                <input asp-for="OrganizationTelephone" placeholder="Enter organization phone">
                            </div>
                            <span asp-validation-for="OrganizationTelephone" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="OrganizationAddress">Organization Address</label>
                            <div class="input-group">
                                <i class="fas fa-map-marker-alt"></i>
                                <textarea asp-for="OrganizationAddress" placeholder="Enter organization address" rows="3"></textarea>
                            </div>
                            <span asp-validation-for="OrganizationAddress" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="OrganizationDescription">Organization Description</label>
                            <div class="input-group">
                                <i class="fas fa-info-circle"></i>
                                <textarea asp-for="OrganizationDescription" placeholder="Describe your organization" rows="3"></textarea>
                            </div>
                            <span asp-validation-for="OrganizationDescription" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Password</label>
                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" placeholder="Create a password" required>
                            <button type="button" class="password-toggle" id="passwordToggle">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input asp-for="ConfirmPassword" placeholder="Confirm your password" required>
                            <button type="button" class="password-toggle" id="confirmPasswordToggle">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-options">
                        <label class="checkbox-container">
                            <input type="checkbox" id="agreeTerms" name="agreeTerms" required>
                            <span class="checkmark"></span>
                            I agree to the <a href="#" class="terms-link">Terms of Service</a> and <a href="#" class="terms-link">Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary auth-btn" id="registerBtn">
                        <span class="btn-text">Create Account</span>
                        <i class="fas fa-spinner fa-spin btn-spinner" style="display: none;"></i>
                    </button>
                </form>

                <div class="auth-footer">
                    <p>Already have an account? <a asp-action="Login" class="auth-link">Sign in here</a></p>
                </div>
            </div>
        </div>
    </main>
</body>

@section Scripts {
    <script>
        document.getElementById('roleSelect').addEventListener('change', function() {
            var organizationFields = document.getElementById('organizationFields');
            if (this.value == '@((int)EventTicketingWebApp.Helpers.UserRole.Organizer)') {
                organizationFields.style.display = 'block';
            } else {
                organizationFields.style.display = 'none';
            }
        });
    </script>
}
