@model dynamic
@{
    ViewData["Title"] = "Sign In - ETicketing System";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<body class="auth-body">
    <!-- Main Content -->
    <main class="auth-main">
        <div class="auth-container">
            <!-- Auth Side Panel -->
            <div class="auth-side-panel">
                <div class="side-panel-content">
                    <h2>Join Thousands of Event Lovers</h2>
                    <p>Discover amazing events, book tickets instantly, and create unforgettable memories.</p>
                    
                    <div class="features-list">
                        <div class="feature-item">
                            <i class="fas fa-ticket-alt"></i>
                            <span>Easy ticket booking</span>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-shield-alt"></i>
                            <span>Secure payments</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-card">
                <div class="auth-header-section">
                    <div class="auth-logo">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <h1>Welcome Back</h1>
                    <p>Sign in to your account to continue</p>
                </div>

                <form class="auth-form" id="loginForm" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <div class="input-group">
                            <i class="fas fa-envelope"></i>
                            <input type="email" id="email" name="email" placeholder="Enter your email" value="@(Model?.Email ?? "")" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="password" name="password" placeholder="Enter your password" required>
                            <button type="button" class="password-toggle" id="passwordToggle">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="checkbox-container">
                            <input type="checkbox" id="rememberMe" name="rememberMe">
                            <span class="checkmark"></span>
                            Remember me
                        </label>
                        <a href="#" class="forgot-password">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary auth-btn" id="loginBtn">
                        <span class="btn-text">Sign In</span>
                        <i class="fas fa-spinner fa-spin btn-spinner" style="display: none;"></i>
                    </button>
                </form>

                <div class="auth-footer">
                    <p>Don't have an account? <a asp-action="Register" class="auth-link">Sign up here</a></p>
                </div>
            </div>
        </div>
    </main>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container"></div>

    <script>
        // Show toast notification if there's an error message
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                showNotification('@Html.Raw(TempData["ErrorMessage"])', 'error');
            });
            </text>
        }
    </script>
</body>
