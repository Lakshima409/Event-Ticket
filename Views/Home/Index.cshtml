@{
    ViewData["Title"] = "ETicketing System - Book Your Events";
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <h1>Discover Amazing Events</h1>
        <p>Book tickets for concerts, sports, theater, and more exciting events</p>
        <div class="search-container">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Search for events, artists, or venues..." id="searchInput">
                <button class="search-btn">Search</button>
            </div>
        </div>
    </div>
</section>

<!-- Filters Bar -->
<section class="filters-bar">
    <div class="container">
        <div class="filters-wrapper">
            <!-- Quick Filter Pills -->
            <div class="quick-filters">
                <button class="filter-pill active" data-filter="all">
                    <i class="fas fa-th-large"></i> All Events
                </button>
                <button class="filter-pill" data-filter="concert">
                    <i class="fas fa-music"></i> Concerts
                </button>
                <button class="filter-pill" data-filter="theater">
                    <i class="fas fa-theater-masks"></i> Theatre
                </button>
                <button class="filter-pill" data-filter="cultural">
                    <i class="fas fa-palette"></i> Cultural Events
                </button>
            </div>

            <!-- Advanced Filters Button -->
            <div class="advanced-filters">
                <button class="btn btn-outline filter-toggle-btn" id="filterToggleBtn">
                    <i class="fas fa-filter"></i> More Filters
                    <i class="fas fa-chevron-down" id="filterChevron"></i>
                </button>
            </div>
        </div>

        <!-- Expandable Advanced Filters -->
        <div class="advanced-filters-panel" id="advancedFiltersPanel">
            <div class="filters-grid">
                <div class="filter-group">
                    <h4>Venue Type</h4>
                    <div class="filter-options">
                        <label class="filter-checkbox">
                            <input type="checkbox" value="stadium" data-filter="venue">
                            <span class="checkmark"></span>
                            Stadium
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="theater" data-filter="venue">
                            <span class="checkmark"></span>
                            Theater
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="concert-hall" data-filter="venue">
                            <span class="checkmark"></span>
                            Concert Hall
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="outdoor" data-filter="venue">
                            <span class="checkmark"></span>
                            Outdoor
                        </label>
                    </div>
                </div>

                <div class="filter-group">
                    <h4>Date</h4>
                    <div class="filter-options">
                        <label class="filter-checkbox">
                            <input type="checkbox" value="today" data-filter="date">
                            <span class="checkmark"></span>
                            Today
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="tomorrow" data-filter="date">
                            <span class="checkmark"></span>
                            Tomorrow
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="this-week" data-filter="date">
                            <span class="checkmark"></span>
                            This Week
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="this-month" data-filter="date">
                            <span class="checkmark"></span>
                            This Month
                        </label>
                    </div>
                </div>

                <div class="filter-group">
                    <h4>Price Range</h4>
                    <div class="filter-options">
                        <label class="filter-checkbox">
                            <input type="checkbox" value="0-50" data-filter="price">
                            <span class="checkmark"></span>
                            $0 - $50
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="50-100" data-filter="price">
                            <span class="checkmark"></span>
                            $50 - $100
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="100-200" data-filter="price">
                            <span class="checkmark"></span>
                            $100 - $200
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="200+" data-filter="price">
                            <span class="checkmark"></span>
                            $200+
                        </label>
                    </div>
                </div>
            </div>

            <div class="filter-actions">
                <button class="btn btn-outline" id="clearFilters">Clear All</button>
                <button class="btn btn-primary" id="applyFilters">Apply Filters</button>
            </div>
        </div>

        <!-- Active Filters Display -->
        <div class="active-filters" id="activeFilters">
            <!-- Active filters will be displayed here -->
        </div>
    </div>
</section>

<!-- Main Content -->
<main class="main-content">
    <div class="container">
        <!-- Upcoming Events Section -->
        <section class="events-section">
            <div class="section-header">
                <h2>Upcoming Events</h2>
                <a href="#" class="view-all">View All <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="events-grid" id="upcomingEvents">
                <!-- Events will be populated by JavaScript -->
            </div>
        </section>

        <!-- Popular Events Section -->
        <section class="events-section popular-events">
            <div class="section-header">
                <h2>Popular Events</h2>
                <a href="#" class="view-all">View All <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="events-grid" id="popularEvents">
                <!-- Events will be populated by JavaScript -->
            </div>
        </section>
    </div>
</main>

<!-- Newsletter Section -->
<section class="newsletter">
    <div class="container">
        <div class="newsletter-content">
            <h3>Stay Updated</h3>
            <p>Get notified about new events and exclusive offers</p>
            <div class="newsletter-form">
                <input type="email" placeholder="Enter your email address" id="newsletterEmail">
                <button class="btn btn-primary">Subscribe</button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/page-home.js" asp-append-version="true"></script>
}
